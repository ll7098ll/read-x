rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Item Bank Collections (96 Expository + 36 Common Foundation + Master Taxonomy)
    // Readable by all authenticated learners/parents/teachers; writable by teachers & admins
    match /item_bank_expository/{slotId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'teacher');
    }
    match /item_bank_common/{code} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'teacher');
    }
    match /curriculum_goals/{goalCode} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // 2. Learner Profiles & 6D X-Ray Mastery State
    match /student_profiles/{studentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == studentId || request.auth.token.role == 'teacher' || request.auth.token.role == 'admin');
    }

    // 3. Question Attempt Telemetry & Clinic Assignments
    match /question_attempts/{attemptId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
    match /clinic_assignments/{assignmentId} {
      allow read, write: if request.auth != null;
    }
  }
}
